{
  "description": "Safety hooks: ask before destructive commands (rm -rf outside the project, destructive SQL, production deploys/resets) and before writing content that looks like a secret.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-destructive-command.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-secret-exposure.sh\""
          }
        ]
      }
    ]
  }
}
